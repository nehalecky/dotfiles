# Git Configuration
# Managed by chezmoi

[user]
    name = {{ .git_name }}
    email = {{ .git_email }}
{{- if .git_signing_key }}
    signingkey = {{ .git_signing_key }}
{{- end }}

[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowed_signers

[init]
    defaultBranch = main

[pull]
    rebase = true

[core]
    editor = code --wait
{{ if eq .profile "work" -}}
# Dual-identity: route work email/signing config inside Descript repos.
# TODO(work-device): confirm gitdir path matches actual repo layout on the work machine (#follow-up).
[includeIf "gitdir:~/work/descript/"]
    path = ~/.config/git/config-work
{{ end -}}
