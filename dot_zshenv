# Ensure that a non-login, non-interactive shell has a defined environment.
if [[ ( "$SHLVL" -eq 1 && ! -o LOGIN ) && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi

# 1Password SSH Agent
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
export GOPATH=$HOME/.local/share/go

# Claude Code hook personalization
export ENGINEER_NAME="Nico"

# Authenticate op CLI once at shell start so secret reads below are silent.
# Only run `op signin` on macOS with the 1Password desktop app (Touch ID flow).
# On Linux/Coder, `op` is authenticated via OP_SERVICE_ACCOUNT_TOKEN if set;
# otherwise `op read` below fails silently and secrets stay unset.
if [[ -o interactive ]] && command -v op &>/dev/null; then
    if ! op whoami &>/dev/null; then
        if [[ "$OSTYPE" == darwin* ]] && [[ -d "/Applications/1Password.app" ]]; then
            op signin --account team-descript.1password.com
        fi
    fi
fi

# Skillzilla telemetry — only resolve in interactive shells to avoid op popup
# on every non-interactive subprocess CC spawns; subshells inherit from parent.
[[ -o interactive ]] && export SKILLZILLA_HC_WRITE_KEY=${SKILLZILLA_HC_WRITE_KEY:-$(op read "op://Engineering/Honeycomb Skillzilla Ingest Key/password" 2>/dev/null)}
[[ -o interactive ]] && export OPENAI_API_KEY=${OPENAI_API_KEY:-$(op read "op://Employee/OpenAI API Key/password" 2>/dev/null)}
